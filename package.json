{
  "name": "gogig-mcp",
  "version": "0.5.0",
  "private": true,
  "description": "MCP server that lets Claude read gogig campaign data and create reports, as the signed-in gogig user",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "start": "node dist/http.js",
    "start:stdio": "node dist/stdio.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "bcryptjs": "^2.4.3",
    "express": "^4.22.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.15",
    "typescript": "^5.9.3"
  }
}
