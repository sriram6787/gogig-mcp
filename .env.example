# gogig API and UI
GOGIG_API_URL=http://localhost:5000
GOGIG_UI_URL=http://localhost:3000

# AuthClient row the gateway signs in as (see README: "The mcp_gogig client")
GOGIG_CLIENT_ID=mcp_gogig
GOGIG_CLIENT_SECRET=
# Sent as Origin when exchanging codes; must be in that client's allowedUrls
GOGIG_AUTH_ORIGIN=http://localhost:5100

# This gateway's public https address (a tunnel locally). Setting it turns on OAuth.
MCP_PUBLIC_URL=
# MCP_OAUTH=off      # pasted-token mode instead of OAuth
# MCP_PORT=5100
# MCP_HOST=127.0.0.1
# MCP_DEBUG=1        # log each sign-in request and answer, secrets cut short
